{
  "version": 3,
  "configurePresets": [
    {
      "name": "vcpkg-x64-windows",
      "displayName": "MSVC x64 with vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_PREFIX_PATH": "C:/vcpkg/installed/x64-windows",
        "BUILD_TESTS": "ON",
        "BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "vcpkg-mingw",
      "displayName": "MinGW x64 with vcpkg",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-mingw",
      "toolchainFile": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "CMAKE_PREFIX_PATH": "C:/vcpkg/installed/x64-mingw-dynamic",
        "BUILD_TESTS": "ON",
        "BUILD_EXAMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vcpkg-x64-windows-debug",
      "configurePreset": "vcpkg-x64-windows",
      "configuration": "Debug"
    },
    {
      "name": "vcpkg-x64-windows-release",
      "configurePreset": "vcpkg-x64-windows",
      "configuration": "Release"
    }
  ]
}
